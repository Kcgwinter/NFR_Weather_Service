@page "/weather"
@page "/"
@using NFR_Weather_Service.Components.Weather
@using NFR_Weather_Service.Models
@using NFR_Weather_Service.Services

@attribute [StreamRendering]
@rendermode InteractiveServer

@inject WeatherService WeatherService
@inject ILogger<WeatherReport> Logger

<PageTitle>Weather Data</PageTitle>

<h1>Weather Preservation Weather Demo (NFR)</h1>

<p>Welcome! <br/> this is a demo for the interview process at NFR</p>

<input @bind="_addressString" placeholder="Enter US street address..." class="form-control rounded" style="min-width: 300px;"/>
<button @onclick="LoadWeatherInformation" disabled="@_isLoading" class="btn rounded px-4">
@if(_isLoading)
{
    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true></span>
    <span>Loading ...</span>
}
else
{
    <span>Search</span>
}
</button>

<div class="mt-3">
    @if (_isLoading)
    {
        <p>
            <em>Loading...</em>
        </p>
    }
    else if(!string.IsNullOrEmpty(_errorMessage))
    {
        <div>
            <strong>Unable to generate report</strong>
            <p>@_errormessage</p>
        </div>
    }
    else if (_weatherReport == null)
    {
        <p>No weather information loaded yet</p>
        <p>Enter full address above in the search field (e.g. <em>136 Maple Ave, Claremont, NH 03743</em> to receive weather data</p>
    }
    else
    {
        <WeatherReportCard Report="@_weatherReport"/>
    }
</div>

@code {
    private WeatherReport? _weatherReport;
    private string? _addressString;
    private bool _isLoading;
    private string> _errorMessage;

    private async Task LoadWeatherInformation()
    {
        if (string.IsNullOrWhiteSpace(_addressString))
            {
                _errorMessage = "Please enter a valid US street address";
                _weatherReport = null;
                return;
            }

        _isLoading = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Receiving weather data for: {Address}", _addressString);
            _weatherReport = await WeatherService.GetReportDataAsync(_addressString);
            _errorMessage = "";
            Console.WriteLine(_weatherReport);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Network or Http error while receiving address weather data for: {Address}", _addressString);
            _errorMessage = "No connection to weather service. Please check your network connection or try again later.";
            _weatherReport = null;
        }
        catch (Exception e)
        {
            Logger.LogWarning(ex, "Couldn't resolve weather data for: {Address}", _addressString);
            _errorMessage = ex.Message;
            _weatherReport = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

}
